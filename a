/* results */
table.res{border-collapse:collapse;width:100%;font-variant-numeric:tabular-nums}
table.res th,table.res td{padding:10px 8px;border-bottom:1px solid var(--edge);text-align:left}
table.res th{font-size:.75rem;letter-spacing:.1em;text-transform:uppercase;color:var(--ash)}
table.res td.n{font-family:var(--mono);text-align:right}
.big{font-family:var(--display);font-size:3rem;color:var(--candle);line-height:1}
.note{font-size:.9rem;border-left:3px solid var(--pumpkin);padding:8px 12px;background:var(--crypt)}
.confirm{border:1px solid var(--blood);border-radius:8px;padding:14px;display:flex;flex-direction:column;gap:10px}
.toast{position:fixed;left:50%;bottom:calc(20px + env(safe-area-inset-bottom,0px));transform:translateX(-50%);background:var(--mist);border:1px solid var(--candle);padding:10px 16px;border-radius:8px;max-width:calc(100% - 32px);z-index:20}

.flicker{animation:flick 4s infinite}
@keyframes flick{0%,100%{opacity:1}46%{opacity:1}48%{opacity:.7}50%{opacity:1}53%{opacity:.8}55%{opacity:1}}
.rise{animation:rise .35s ease-out}
@keyframes rise{from{transform:translateY(6px);opacity:.4}to{transform:none;opacity:1}}
@media (prefers-reduced-motion:reduce){.flicker,.rise{animation:none}.room:hover{transform:none}}
