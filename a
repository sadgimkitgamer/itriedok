  if(locked&&cur.some((v,i)=>v!==i))el.append(h("div",{class:"note",style:"margin-top:10px"},h("b",null,"Correct order: "),q.items.map((t,i)=>(i+1)+". "+t).join("  →  ")));},
 fill(q,el,r,locked,set){const inp=h("input",{type:"text",id:q.id+"-fill",value:r||"",disabled:locked,autocomplete:"off","aria-label":"Your answer",oninput:e=>set(e.target.value),onkeydown:e=>{if(e.key==="Enter"){const b=el.closest(".qcard").querySelector(".navrow .btn");b&&!b.disabled&&b.click();}}});
  el.append(inp);if(!locked)setTimeout(()=>inp.focus(),30);},
 written(q,el,r,locked,set){const cnt=h("p",{class:"muted",style:"font-size:.85rem;margin-top:6px"});
  const upd=v=>{const n=v.trim().length;cnt.textContent=locked?"Submitted response ("+n+" characters).":n<MINWR?"Write at least "+MINWR+" characters ("+n+" so far).":n+" characters. Ready to seal.";};
