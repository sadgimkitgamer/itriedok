  case"written":return null;}}
function rowLabel(q,i){return q.code?("line "+q.rows[i][0]):("row "+(i+1)+" ("+q.rows[i][0]+")")}
function respText(q,r){if(r==null)return"Not attempted";switch(q.type){
  case"mc":case"tf":return q.options[r];
  case"multi":return r.length?r.map(i=>q.options[i]).join("; "):"(none selected)";
  case"hotspot":return r.length?r.map(i=>q.segs[i].text).join(" | "):"(nothing flagged)";
  case"log":return r.length?r.slice().sort((a,b)=>a-b).map(i=>rowLabel(q,i)).join(", "):"(nothing flagged)";
  case"match":return q.pairs.map((p,i)=>p[0]+" = "+(r[i]==null?"(blank)":q.pairs[r[i]][1])).join("; ");
  case"sort":return q.items.map((it,i)=>it.text+" -> "+(r[i]==null?"(blank)":q.cats[r[i]])).join("; ");
