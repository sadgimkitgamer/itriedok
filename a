/* =================== SAVE / RESUME (move between computers) =================== */
const QBYID={};ROOMS.forEach(r=>r.qs.forEach(q=>QBYID[q.id]=q));
const SALT="hn-u1-lantern-2026";
function cyrb53(str,seed=0){let h1=0xdeadbeef^seed,h2=0x41c6ce57^seed;for(let i=0;i<str.length;i++){const ch=str.charCodeAt(i);h1=Math.imul(h1^ch,2654435761);h2=Math.imul(h2^ch,1597334677);}
  h1=Math.imul(h1^(h1>>>16),2246822507);h1^=Math.imul(h2^(h2>>>13),3266489909);h2=Math.imul(h2^(h2>>>16),2246822507);h2^=Math.imul(h1^(h1>>>13),3266489909);return(4294967296*(2097151&h2)+(h1>>>0)).toString(36);}
function b64u(bytes){let s="";for(let i=0;i<bytes.length;i+=0x8000)s+=String.fromCharCode.apply(null,bytes.subarray(i,i+0x8000));return btoa(s).replace(/\+/g,"-").replace(/\//g,"_").replace(/=+$/,"");}
function unb64u(s){s=s.replace(/-/g,"+").replace(/_/g,"/");while(s.length%4)s+="=";const bin=atob(s);const out=new Uint8Array(bin.length);for(let i=0;i<bin.length;i++)out[i]=bin.charCodeAt(i);return out;}
async function pack(str){const bytes=new TextEncoder().encode(str);
  if(window.CompressionStream){try{const st=new Blob([bytes]).stream().pipeThrough(new CompressionStream("deflate-raw"));return{z:1,b:new Uint8Array(await new Response(st).arrayBuffer())};}catch(e){}}
  return{z:0,b:bytes};}
async function unpack(b,z){if(!z)return new TextDecoder().decode(b);
  if(!window.DecompressionStream)throw new Error("This browser is too old to read compressed saves. Try Chrome or Edge.");
  const st=new Blob([b]).stream().pipeThrough(new DecompressionStream("deflate-raw"));return await new Response(st).text();}
async function makeCode(){
  const payload=JSON.stringify({v:1,name:S.name,period:S.period,started:S.started,saved:new Date().toISOString(),resumes:S.resumes||[],
    answers:Object.fromEntries(Object.entries(S.answers).map(([k,a])=>[k,{r:a.r,at:a.at}]))});
  const {z,b}=await pack(payload);const body=b64u(b);return"HN"+z+"."+body+"."+cyrb53(body+SALT);}
async function readCode(raw){
  const code=String(raw).replace(/\s+/g,"");
  const m=/^HN([01])\.([A-Za-z0-9_-]+)\.([a-z0-9]+)$/.exec(code);
  if(!m)throw new Error("That isn't a Haunted Network resume code. Copy the whole code, starting with HN.");
  if(cyrb53(m[2]+SALT)!==m[3])throw new Error("This save was changed or got cut off. Copy the complete code again, or use your save file.");
  let data;try{data=JSON.parse(await unpack(unb64u(m[2]),m[1]==="1"));}catch(e){throw new Error("This save could not be read. Try the save file instead, or ask your teacher.");}
  if(!data||data.v!==1||!data.name||!data.answers)throw new Error("This save is missing information. Ask your teacher.");
  return data;}
function restoreFrom(data,how){
  const ans={};
  for(const [k,a] of Object.entries(data.answers)){const q=QBYID[k];if(!q||!a||!isComplete(q,a.r))continue;
    try{const f=grade(q,a.r);ans[k]={r:a.r,pts:f==null?0:Math.round(f*PTS),frac:f,at:a.at};}catch(e){}}
  S={name:String(data.name),period:String(data.period),started:data.started,answers:ans,
     resumes:[...(Array.isArray(data.resumes)?data.resumes:[]),{at:new Date().toISOString(),how,saved:data.saved}]};
  save();return Object.keys(ans).length;}
function safeName(){return S.name.replace(/[^A-Za-z0-9]+/g,"_").replace(/^_|_$/g,"");}
async function saveBlob(filename,data,status,okMsg){
  if(DL){try{await DL.save({filename,data});status.textContent=okMsg;}
    catch(e){status.textContent=e&&e.code==="declined"?"Save cancelled. Click again when you're ready.":e&&e.code==="rate_limited"?"A save prompt is already open. Finish that one first.":"The save didn't go through. Use Copy resume code instead.";}
    return;}
  try{const u=URL.createObjectURL(data instanceof Blob?data:new Blob([data],{type:"application/json"}));const a=h("a",{href:u,download:filename,style:"display:none"});document.body.append(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(u),60000);}catch(e){}
  status.textContent=okMsg+" If no file appeared, use Copy resume code instead.";}
function savePanel(title,highlight){
  const status=h("p",{class:"muted",role:"status"});
  const box=h("textarea",{readonly:true,hidden:true,class:"codebox","aria-label":"Your resume code"});
  return h("section",{class:"panel stack savepanel"+(highlight?" hl":"")},
    h("h3",null,title),
    h("p",null,"Tomorrow, on any computer: open the game, choose ",h("b",null,"Started on another computer?"),", and load this. Keep it somewhere you can reach, like your email, Google Drive or a Canvas draft."),
    h("div",{class:"row"},
      h("button",{class:"btn",onclick:async()=>{status.textContent="Preparing your save file...";
        const code=await makeCode();const file=JSON.stringify({format:"haunted-network-save",version:1,name:S.name,period:S.period,savedAt:new Date().toISOString(),code},null,1);
        const fn="HauntedNetwork_Save_"+safeName()+".json";await saveBlob(fn,file,status,"Saved "+fn+". Upload it to your Google Drive or email it to yourself.");}},"Download save file"),
      h("button",{class:"btn ghost",onclick:async()=>{const code=await makeCode();box.value=code;
        const fallback=()=>{box.hidden=false;box.focus();box.select();status.textContent="Select all of the code below, copy it, and paste it somewhere safe (email, Drive, a Canvas draft).";};
        try{navigator.clipboard.writeText(code).then(()=>{box.hidden=false;status.textContent="Resume code copied ("+code.length+" characters). Paste it somewhere safe, like an email to yourself.";},fallback);}catch(e){fallback();}}},"Copy resume code")),
    status,box);}
function resumePanel(){
  const status=h("p",{class:"muted",role:"alert"});
  const fileIn=h("input",{type:"file",id:"resume-file",accept:".json,.txt,application/json,text/plain"});
  const ta=h("textarea",{id:"resume-code",class:"codebox",placeholder:"Or paste your resume code here (it starts with HN)"});
  const load=async(text,how)=>{
    try{let code=String(text).trim();
      if(code.startsWith("{")){const j=JSON.parse(code);if(j.format!=="haunted-network-save")throw new Error("That file isn't a Haunted Network save file.");code=j.code;}
      const data=await readCode(code);const n=restoreFrom(data,how);
      toast("Welcome back, "+S.name+". "+n+" answers restored.");go({screen:"map"});}
    catch(e){status.textContent=e.message||"That save could not be loaded.";}};
  fileIn.addEventListener("change",()=>{const f=fileIn.files&&fileIn.files[0];if(!f)return;const rd=new FileReader();rd.onload=()=>load(rd.result,"file");rd.onerror=()=>status.textContent="That file could not be opened.";rd.readAsText(f);});
  return h("div",{class:"stack resumebox",style:"gap:10px"},
    h("p",{class:"eyebrow"},"Load saved progress"),
    h("div",{class:"stack",style:"gap:6px"},h("label",{for:"resume-file"},"Choose your save file (HauntedNetwork_Save_....json)"),fileIn),
    h("div",{class:"stack",style:"gap:6px"},h("label",{for:"resume-code"},"Or paste your resume code"),ta),
    h("div",null,h("button",{class:"btn ghost",onclick:()=>{if(!ta.value.trim()){status.textContent="Paste your resume code first, or choose your save file above.";return;}load(ta.value,"code");}},"Load my code")),
    status);}

/* =================== REPORT =================== */
function fileName(){return("HauntedNetwork_"+S.name.replace(/[^A-Za-z0-9]+/g,"_")+"_P"+String(S.period).replace(/[^A-Za-z0-9]+/g,"")+".pdf").replace(/_+/g,"_");}
function fmt(iso){try{return new Date(iso).toLocaleString([], {dateStyle:"medium",timeStyle:"short"})}catch(e){return iso}}
function reportBlocks(){const t=totals();const B=[];
  B.push(["h1","The Haunted Network - AP Cybersecurity Unit 1 Review"]);
  B.push(["kv","Student: "+S.name+"     Period: "+S.period]);
  B.push(["kv","Started: "+fmt(S.started)+"     Report generated: "+fmt(new Date().toISOString())]);
  B.push(["kv","Auto-scored: "+t.e+" / "+t.m+" ("+(t.m?Math.round(100*t.e/t.m):0)+"%)     Challenges answered: "+t.done+" / "+t.tot+"     Written responses: "+t.wrd+" / "+t.wr]);
  [1,2].forEach(n=>{const tn=totals(r=>r.night===n);B.push(["kv","Night "+n+" (Day "+n+"): "+tn.e+" / "+tn.m+" auto-scored, "+tn.done+" / "+tn.tot+" answered"]);});
  (S.resumes||[]).forEach(m=>B.push(["kv","Moved computers: progress saved "+fmt(m.saved)+", loaded "+fmt(m.at)+" from a "+(m.how==="file"?"save file":"resume code")+". Scores were recalculated on load."]));
  B.push(["kv","Teacher score for written responses: ______ / "+(t.wr*4)+"  (4 pts each)"]);
  ROOMS.forEach(r=>{const s=roomStats(r);
    B.push(["h2","Night "+r.night+": "+r.name+"  ("+r.topic+")  -  "+s.earned+" / "+s.max]);
    r.qs.forEach(q=>{const a=S.answers[q.id];
      B.push(["q","Q"+q.n+". ["+TYPE_LABEL[q.type]+", "+q.lo+"] "+stripTags(q.prompt)]);
      if(q.type==="written"){B.push(["p","Response"+(a?" ("+fmt(a.at)+")":"")+":"]);B.push(["resp",a?a.r:"Not attempted"]);B.push(["small","Look-fors: "+q.rubric+".     Teacher score: ____ / 4"]);}
      else{B.push(["p","Your answer: "+respText(q,a?a.r:null)]);
        if(a&&a.pts<PTS)B.push(["p","Correct answer: "+correctText(q)]);
        B.push([a&&a.pts===PTS?"good":"pts","Points: "+(a?a.pts:0)+" / "+PTS]);}
    });});
  return B;}
function ascii(s){return String(s).replace(/[‘’]/g,"'").replace(/[“”]/g,'"').replace(/[—–]/g,"-").replace(/…/g,"...").replace(/→/g,"->").replace(/ä/g,"a").replace(/[^\x09\x0A\x0D\x20-\x7E\xA0-\xFF]/g,"")}
function reportText(){return reportBlocks().map(([k,s])=>k==="h1"?s.toUpperCase():k==="h2"?"\n== "+s+" ==":k==="q"?"\n"+s:k==="resp"?"  \""+s+"\"":"  "+s).join("\n");}
function buildPDF(){const {jsPDF}=window.jspdf;const doc=new jsPDF({unit:"pt",format:"letter"});
  const M=50,PW=612,PH=792,W=PW-2*M;let y=M;
  const need=hh=>{if(y+hh>PH-M){doc.addPage();y=M;}};
  const put=(str,{size=10,bold=false,color=[34,30,40],indent=0,after=3,italic=false}={})=>{doc.setFont("helvetica",bold?"bold":italic?"italic":"normal");doc.setFontSize(size);doc.setTextColor(...color);
    const lines=doc.splitTextToSize(ascii(str),W-indent),lh=size*1.32;lines.forEach(l=>{need(lh);doc.text(l,M+indent,y+size);y+=lh;});y+=after;};
  // header band
  doc.setFillColor(31,25,40);doc.rect(0,0,PW,8,"F");doc.setFillColor(242,137,43);doc.rect(0,8,PW,3,"F");
  reportBlocks().forEach(([k,s])=>{switch(k){
    case"h1":y+=6;put(s,{size:17,bold:true,color:[31,25,40],after:8});break;
    case"kv":put(s,{size:10,after:2});break;
    case"h2":y+=12;need(30);doc.setDrawColor(242,137,43);doc.setLineWidth(1.2);doc.line(M,y,M+W,y);y+=6;put(s,{size:12.5,bold:true,color:[150,70,10],after:4});break;
    case"q":y+=4;put(s,{size:10,bold:true,after:2});break;
    case"p":put(s,{size:9.5,indent:12,after:1});break;
    case"resp":put(s,{size:9.5,indent:12,italic:true,color:[60,40,110],after:2});break;
    case"small":put(s,{size:8.5,indent:12,color:[110,100,115],after:2});break;
    case"good":put(s,{size:9.5,indent:12,bold:true,color:[40,120,60],after:2});break;
    case"pts":put(s,{size:9.5,indent:12,bold:true,color:[170,60,45],after:2});break;}});
  const n=doc.getNumberOfPages();for(let i=1;i<=n;i++){doc.setPage(i);doc.setFont("helvetica","normal");doc.setFontSize(8);doc.setTextColor(130,120,135);
    doc.text(ascii(S.name+" - Period "+S.period+" - The Haunted Network"),M,PH-24);doc.text("Page "+i+" of "+n,PW-M,PH-24,{align:"right"});}
  return doc.output("blob");}

render();
