  el.append(h("div",{class:"tblwrap"},h("table",{class:"log"+(q.code?" code":"")},h("thead",null,h("tr",null,h("th",null,"Flag"),...q.cols.map(c=>h("th",null,c)))),tb)),
    h("p",{class:"muted",style:"font-size:.85rem;margin-top:8px"},locked?"Green = correctly flagged, red = flagged by mistake, outlined = an indicator you missed.":"Use the Flag button on each suspicious row. Scroll the table sideways on small screens."));},
 match(q,el,r,locked,set){const cur=[...r];const order=shuffleIdx(q.pairs.length,q.id+"m");const box=h("div",{class:"pairs"});
  q.pairs.forEach((p,i)=>{const sel=h("select",{id:q.id+"-s"+i,disabled:locked,onchange:e=>{cur[i]=e.target.value===""?null:Number(e.target.value);set([...cur]);}},
