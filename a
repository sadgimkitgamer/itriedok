  case"log":return q.flags.map(i=>rowLabel(q,i)).join(", ");
  case"match":return q.pairs.map(p=>p[0]+" = "+p[1]).join("; ");
  case"sort":return q.items.map(it=>it.text+" -> "+q.cats[it.cat]).join("; ");
  case"order":return q.items.map((t,i)=>(i+1)+". "+t).join("  ");
