<script>
/* =================== QUESTION BANK =================== */
const TF=["True","False"];
const ROOMS=[
{ id:"r1", night:1, name:"The Phantom Postmaster", topic:"1.1 Understanding Social Engineering", los:"1.1.A-C",
  brief:"Letters slide under the door of this room all night long. Some are real. Most are bait. Scenario 1A: you are next to your teacher when a 'Google Drive Team' email from do-not-reply@g00gle.com says a student needs urgent access to a document. Your teacher reaches for the link. Your job is to spot the tricks before anyone clicks.",
  qs:[
  {type:"hotspot", lo:"1.1.A", prompt:"This email just landed in your school inbox. <b>Click every part of it that is an indicator of social engineering</b>, then submit. Leave normal parts unflagged.",
    segs:[
      {hdr:true, text:'From: "Canvas Support" <alerts@canvas-instruct0r.net>', flag:true, why:"The sender domain is not your school's, and it swaps a zero in for the letter o."},
      {hdr:true, text:"To: you@school.edu", flag:false},
      {hdr:true, text:"Subject: FINAL WARNING: Account deletion in 60 minutes", flag:true, why:"All-caps 'FINAL WARNING' plus a countdown creates urgency."},
      {text:"Dear Student,", flag:true, why:"A generic greeting suggests a mass message, not one from a system that knows you."},
      {text:"Thank you for using Canvas this semester.", flag:false},
      {text:"If you do not verify within 60 minutes, all of your submitted assignments and grades will be permanently erased.", flag:true, why:"Threatening a loss is intimidation; the 60-minute deadline is urgency."},
      {text:"Reply with your password and the 6-digit code we just texted you.", flag:true, why:"Asking for a password or one-time code is elicitation. No real service asks for these."},
      {text:"Verify now: https://canvas.school.edu/verify", tip:"link actually points to http://canvas-verify.acct-secure.ru", flag:true, why:"The visible link text does not match where the link really goes."},
      {text:"- Canvas Security Team", flag:false}
    ], explain:"Six red flags: a look-alike sender, an urgent subject, a generic greeting, an intimidating threat, a request for secret codes, and a disguised link."},
  {type:"sort", lo:"1.1.A", prompt:"Sort each line from a suspicious message by the psychological tactic it uses.",
    cats:["Urgency","Intimidation","Neither"],
    items:[
      {text:"Only 3 spots left. Act now!", cat:0},
      {text:"If you don't pay the fee, we will report you to the police.", cat:1},
      {text:"Failure to verify will result in suspension and loss of all your files.", cat:1},
      {text:"This link expires at midnight tonight.", cat:0},
      {text:"Here are the notes from today's club meeting.", cat:2},
      {text:"Respond in the next 15 minutes to keep your reservation.", cat:0},
      {text:"We will tell your principal about the violation unless you reply.", cat:1}
    ], explain:"Urgency invents a reason to act fast. Intimidation threatens a negative consequence if you do not comply."},
  {type:"mc", lo:"1.1.A", prompt:"A caller says they are from the district IT office running a 'security survey' and asks for your first pet's name and the street you grew up on. Getting a target to reveal sensitive information this way is called:",
    options:["Jamming","Elicitation","War driving","An evil twin attack"], answer:1,
    explain:"Elicitation is manipulating someone into revealing sensitive information. Those two answers are classic challenge-question answers."},
  {type:"tf", lo:"1.1.A", prompt:"Social engineering only happens through email.", options:TF, answer:1,
    explain:"It can happen in person, by text message, through social media messages, by phone, and by email."},
  {type:"mc", lo:"1.1.B", prompt:"Why does adding urgency to a phishing message work so well?",
    options:["It makes the message pass spam filters","It proves the sender is legitimate","It pressures people to act before they stop to think about whether the action is reasonable or safe","It encrypts the link so it cannot be inspected"], answer:2,
    explain:"Urgency leverages our natural response to react quickly to time-sensitive needs, which cuts short careful thinking."},
  {type:"multi", lo:"1.1.C", prompt:"Select <b>all</b> pieces of information that an adversary could use to impersonate you or answer your account challenge questions.",
    options:["Your birthdate","Your first pet's name","Today's weather forecast","Your workplace or school","A list of national holidays","Your home address"], answer:[0,1,3,5],
    explain:"Personal details like birthdate, pet names, workplace and address are often used as challenge questions to verify identity."},
  {type:"mc", lo:"1.1.C", prompt:"A victim reads a one-time login code to a 'support agent' over the phone. What is the most likely impact?",
    options:["The adversary can log in to the service as the victim","The victim's Wi-Fi gets jammed","The victim's password becomes stronger","Nothing, because one-time codes are public"], answer:0,
    explain:"A one-time password or login code lets the adversary complete the login as the victim."},
  {type:"written", lo:"1.1.A-C", prompt:"<b>Scenario 1A.</b> Your teacher still wants to click the 'Google Drive Team' link from do-not-reply@g00gle.com. In 3-5 sentences, write what you would say to convince them. Cite at least <b>two pieces of evidence</b> from the email, name <b>one psychological tactic</b> it uses, and describe <b>one consequence</b> of clicking.",
    rubric:"Evidence (2) + tactic named and explained + consequence"}
  ]},
{ id:"r2", night:1, name:"The Crypt of Cracked Credentials", topic:"1.2 Suspicious Website Logins", los:"1.2.A-C",
  brief:"Something has been opening coffins down here. Scenario 1B: choices in your online game account changed without your knowledge. You normally log in on evenings and weekends from home. The account activity log is your only witness.",
  qs:[
  {type:"log", lo:"1.2.A", prompt:"Here is the login log for your game account <b>GhoulGamer</b>. You play evenings and weekends from home (IP 73.41.12.88). <b>Flag every row that is suspicious.</b>",
    cols:["Date / Time","IP Address","Device","Result"],
    rows:[
      ["Fri Oct 23 19:41:10","73.41.12.88","Chrome / Windows","Success"],
      ["Sat Oct 24 03:12:05","185.220.101.4","python-requests","Failed"],
      ["Sat Oct 24 03:12:06","185.220.101.4","python-requests","Failed"],
      ["Sat Oct 24 03:12:07","185.220.101.4","python-requests","Failed"],
      ["Sat Oct 24 03:12:09","185.220.101.4","python-requests","Failed"],
      ["Sat Oct 24 03:12:11","185.220.101.4","python-requests","Success"],
      ["Sat Oct 24 14:30:52","73.41.12.88","Chrome / Windows","Success"],
      ["Mon Oct 26 10:47:33","102.89.34.7","Firefox / Linux","Success"],
      ["Mon Oct 26 21:15:02","73.41.12.88","Chrome / Windows","Failed"],
      ["Mon Oct 26 21:15:19","73.41.12.88","Chrome / Windows","Success"]
    ], flags:[1,2,3,4,5,7],
    explain:"Rows 2-6: a burst of failed logins seconds apart at 3 AM from an unknown IP and an automated tool, ending in success. Row 8: a school-hours login from an unknown device. Rows 9-10 are just you mistyping once at home."},
  {type:"multi", lo:"1.2.A", prompt:"Which signs of an online password attack appear in that log? Select all that apply.",
    options:["Many failed login attempts over a short duration","Login attempts at unusual times","Login attempts from unknown devices","Every login came from the owner's home IP"], answer:[0,1,2],
    explain:"All three textbook signs appear. Not every login came from home, which is exactly the problem."},
  {type:"sort", lo:"1.2.B", prompt:"Sort these passwords. Which would survive the crypt, and which would crack?",
    cats:["Strong","Weak"],
    items:[
      {text:"Biscuit2009!", cat:1},
      {text:"t7#Qv9!mLz2@pX4rW", cat:0},
      {text:"Halloween26!", cat:1},
      {text:"lantern-gravel-oyster-mitten-cobalt", cat:0},
      {text:"MomBday0412", cat:1},
      {text:"Jackson15$", cat:1},
      {text:"velvet-cactus-thunder-ladle-91", cat:0}
    ], explain:"Weak ones follow common patterns: word + two-digit number + special character, names, or significant dates. Strong ones are long and random (generated) or long, unique passphrases."},
  {type:"mc", lo:"1.2.B", prompt:"Maya posts constantly about her dog Pepper and mentions she was born in 2008. An adversary builds a password dictionary about her. Which guess would the automated tool most likely try early?",
    options:["Pepper2008!","q8$Zr!e2Lm#9","granite-orbit-sparrow-fennel","X"], answer:0,
    explain:"Adversaries build dictionaries from personal information like pet names and birth years, then let a tool submit the guesses."},
  {type:"order", lo:"1.2.B", prompt:"Put the steps of a targeted dictionary password attack in order.",
    items:["Gather personal details about the target from social media","Build a dictionary of likely passwords from those details","Load the dictionary into an automated login tool","The tool submits guesses to the login page","A guess matches and the adversary logs in"],
    explain:"Recon, then dictionary, then automation. Many rapid failed attempts are the trail this leaves in the log."},
  {type:"fill", lo:"1.2.C", prompt:"A tool that generates and stores long, random, unique passwords for you is called a password ________.",
    accept:["^manager$","^password manager$","^managers$"], answerText:"manager",
    explain:"A password manager means you never need to reuse or memorize weak passwords."},
  {type:"mc", lo:"1.2.C", prompt:"The adversary from the log guesses your correct password, but the login still fails. Which protection most likely stopped them?",
    options:["A longer username","Multifactor authentication requiring a one-time code from your device","Logging in only on weekends","Clearing your browser history"], answer:1,
    explain:"MFA requires extra proof of identity beyond the password, so a stolen or guessed password alone is not enough."},
  {type:"written", lo:"1.2.A-C", prompt:"<b>Scenario 1B.</b> You just found the suspicious entries in your game log. List <b>three actions</b> you would take right now to secure the account and explain <b>why</b> each one helps.",
    rubric:"3 actions (e.g. new long unique password, enable MFA, check other accounts using same password) with reasons"}
  ]},
{ id:"r3", night:1, name:"The Fog-Bound Café", topic:"1.3 Best Practices for Public Networks", los:"1.3.A-C",
  brief:"The fog rolls in, and so do the fake networks. Scenario 1C: you joined 'Guest Wi-Fi' at the coffee shop, entered your platform login on its captive portal, and an hour later you are locked out of your music service. The sign on the wall said 'Sunshine Coffee Wi-Fi' all along.",
  qs:[
  {type:"mc", lo:"1.3.C", prompt:"The sign on the wall says <b>Sunshine Coffee Wi-Fi</b>. Your phone shows these networks. Which one should you join?",
    options:["Sunshine Coffee WiFi","Sunshine_Coffee_Wi-Fi","Sunshine Coffee Wi-Fi","Guest Wi-Fi (strongest signal)"], answer:2,
    explain:"Only join a network whose name exactly matches the one you intend to join. Near-matches are how evil twins catch people."},
  {type:"match", lo:"1.3.B", prompt:"Match each wireless attack to its description.",
    pairs:[
      ["Evil twin","An adversary's access point uses an SSID identical or similar to a real network to capture victims' traffic"],
      ["Jamming","A strong electromagnetic signal on the network's frequency blocks legitimate traffic, causing a denial of service"],
      ["War driving","Detecting wireless network beacons while driving or walking around a target to learn about the network"],
      ["Zero day","An undocumented vulnerability that a high-skilled adversary discovers"]
    ], explain:"Evil twins impersonate, jamming denies service, war driving scouts, and zero days are unknown flaws."},
  {type:"sort", lo:"1.3.A", prompt:"Classify each adversary by skill level.",
    cats:["Low-skilled","High-skilled"],
    items:[
      {text:"Buys a ready-made Wi-Fi attack kit online and runs it", cat:0},
      {text:"Discovers an undocumented vulnerability in a router", cat:1},
      {text:"Modifies existing malware to slip past a new defensive tool", cat:1},
      {text:"Uses a purchased exploit for a well-known, already-patched bug", cat:0},
      {text:"Writes a brand-new malicious tool from scratch", cat:1}
    ], explain:"Low-skilled adversaries rely on tools others built that exploit known vulnerabilities. High-skilled adversaries create or adapt tools and find zero days."},
  {type:"mc", lo:"1.3.A", prompt:"A former employee who was fired logs in with an old account and deletes the company's shared files. Their most likely motivation is:",
    options:["Revenge","Desire for recognition","Dedication to a cause","Politics"], answer:0,
    explain:"Motivations include greed, recognition, a cause, revenge, politics, or beliefs. Getting back at a former employer is revenge."},
  {type:"tf", lo:"1.3.B", prompt:"If you connect to an evil twin, the adversary can read everything you send to a website that uses HTTPS.", options:TF, answer:1,
    explain:"The adversary can capture your traffic, but cannot read traffic protected by an encrypted protocol like HTTPS."},
  {type:"mc", lo:"1.3.B", prompt:"At 4 PM every customer in the café suddenly loses Wi-Fi. A technician measures a very strong radio signal flooding the same frequency range as the network. This is:",
    options:["War driving","An evil twin","A jamming attack, which is a type of denial of service","Elicitation"], answer:2,
    explain:"Jamming floods the area with an EM signal so legitimate traffic cannot reach the access point. It denies service."},
  {type:"mc", lo:"1.3.C", prompt:"You use a VPN on café Wi-Fi. Who can still view your traffic?",
    options:["The café's network","Anyone else on the café Wi-Fi","The VPN provider","Nobody at all"], answer:2,
    explain:"A VPN encrypts traffic to the VPN operator's system, hiding it from the local network, but the VPN provider can see it."},
  {type:"multi", lo:"1.3.C", prompt:"Select all actions that protect your data on public Wi-Fi.",
    options:["Verify the network name exactly matches the one you intend to join","Consider how sensitive your data is before joining an unencrypted network","Use a VPN when handling sensitive data","Join whichever open network has the strongest signal","Type your main platform password into any captive portal that asks"], answer:[0,1,2],
    explain:"Signal strength says nothing about trust, and Scenario 1C shows what happens when you hand your platform login to a fake captive portal."},
  {type:"written", lo:"1.3.C", prompt:"<b>Scenario 1C.</b> Logging in to many services with one platform account was convenient until it wasn't. Explain <b>one benefit</b> and <b>one hazard</b> of using a single platform to log in to multiple services, then describe how you could have avoided joining the malicious network.",
    rubric:"Benefit + hazard (one stolen credential unlocks everything) + avoidance (verify exact SSID)"}
  ]},
{ id:"r4", night:2, name:"The Doppelgänger's Call", topic:"1.4 AI-Based Cybersecurity Attacks", los:"1.4.A-B",
  brief:"The phone rings, and it sounds exactly like you. Scenario 1D: an adversary posing as a classmate friended you, scraped your voice from your videos, cloned it with AI, and called your relative from 'jail' asking for bail money. Your relative wired it.",
  qs:[
  {type:"order", lo:"1.4.A", prompt:"Rebuild the attack chain from Scenario 1D in the order it happened.",
    items:["Adversary sends a friend request using a name like a classmate's","You accept the request","Adversary scrapes voice samples from your videos","Samples are fed into an AI voice-cloning tool","Adversary finds your relative through social media","Relative gets a call in 'your' voice with a fake jail story","Relative wires the bail money"],
    explain:"Every link depended on public voice samples plus an unverified online connection."},
  {type:"mc", lo:"1.4.B", prompt:"What is the best way for your family to verify it is really you on a frantic phone call?",
    options:["Check that the caller ID shows your number","Listen for whether the voice sounds right","Ask for a secret word or phrase you agreed on in advance","Ask the caller what city they are in"], answer:2,
    explain:"A shared secret known only to the two parties can authenticate identity in high-stakes moments. Voices and caller ID can both be faked."},
  {type:"multi", lo:"1.4.A", prompt:"Select <b>all</b> the ways adversaries use AI-powered tools to augment attacks.",
    options:["Cloning a voice or face to impersonate someone on a call","Writing fluent phishing messages in any language","Scanning social media and public sites for reconnaissance","Publishing false information so LLMs trained on it repeat it","Helping write malware or find vulnerabilities in large code bases","Making phishing easier to spot by adding grammar mistakes"], answer:[0,1,2,3,4],
    explain:"The last option is backwards: AI removes the unnatural language that used to give phishing away."},
  {type:"tf", lo:"1.4.A", prompt:"Spelling and grammar mistakes are still a dependable way to identify phishing messages.", options:TF, answer:1,
    explain:"LLMs let adversaries write phishing that reads as if a native speaker wrote it, in any target language."},
  {type:"mc", lo:"1.4.A", prompt:"An adversary sets up dozens of websites that all claim a fake 'fact' about a company. What are they trying to do?",
    options:["Jam the company's Wi-Fi","Get the false information into LLM training sets so AI tools repeat it","Guess the company's passwords","Perform war driving"], answer:1,
    explain:"Publishing or modifying websites with false information can get it into training data, causing LLMs to repeat it."},
  {type:"sort", lo:"1.4.B", prompt:"Would you type this into a public AI chatbot?",
    cats:["Fine to ask","Keep it out"],
    items:[
      {text:"Explain what an evil twin attack is", cat:0},
      {text:"Your list of passwords to 'organize'", cat:1},
      {text:"Your home address and daily schedule", cat:1},
      {text:"A general question about photosynthesis", cat:0},
      {text:"Your employer's unreleased customer database", cat:1},
      {text:"A draft essay that contains no personal details", cat:0}
    ], explain:"Some AI tools feed user input back into training, and adversaries can craft prompts to extract it. Keep personal and sensitive data out."},
  {type:"mc", lo:"1.4.B", prompt:"A bank lets customers log in by saying a passphrase. An adversary clones a customer's voice. What stops the adversary?",
    options:["Nothing can stop a cloned voice","Multifactor authentication requiring a second factor","Speaking more slowly","Using the bank's mobile website"], answer:1,
    explain:"With MFA enabled, a cloned voice alone is not enough. The adversary still needs the second factor."},
  {type:"mc", lo:"1.4.B", prompt:"A chatbot gives you a surprising statistic for your research paper. What should you do?",
    options:["Cite the chatbot as the source","Ask the chatbot if it is sure","Verify it using a reputable, stable, non-AI source","Ignore all statistics"], answer:2,
    explain:"AI output should be carefully evaluated and verified against reputable non-AI sources."},
  {type:"written", lo:"1.4.B", prompt:"<b>Scenario 1D.</b> How could you help protect your relatives from a voice-cloning scam like this one? Describe <b>two specific actions</b> (one you take, one they take) and explain how each breaks the attack chain.",
    rubric:"Two actions (e.g. secret word, limit public voice content, verify connections, call back) tied to the chain"}
  ]},
{ id:"r5", night:2, name:"The Watchtower", topic:"1.5 Leveraging AI in Cyber Defense", los:"1.5.A-B",
  brief:"From the tower, an AI sentry watches millions of events a night. Scenario 1E: before your company launches its new ordering site, an AI code reviewer flags places where user input goes straight into database requests. The developers review the fixes, test, then deploy.",
  qs:[
  {type:"log", code:true, lo:"1.5.A", prompt:"You are the AI reviewer. <b>Flag each line where user input is pasted directly into a database command</b> (the flaw from Scenario 1E).",
    cols:["Line","Code"],
    rows:[
      ["1","app.post('/search', (req, res) => {"],
      ["2","  const item = req.body.item;"],
      ["3","  const sql = \"SELECT qty FROM inventory WHERE name = '\" + item + \"'\";"],
      ["4","  db.query(sql).then(rows => res.json(rows));"],
      ["5","});"],
      ["6","app.post('/buy', (req, res) => {"],
      ["7","  const id = Number(req.body.itemId);"],
      ["8","  db.query(\"UPDATE inventory SET qty = qty - 1 WHERE id = ?\", [id]);"],
      ["9","  const note = req.body.note;"],
      ["10","  db.query(\"INSERT INTO orders (note) VALUES ('\" + note + \"')\");"]
    ], flags:[2,9],
    explain:"Lines 3 and 10 glue raw user text into the command. Line 8 passes the value separately (a placeholder), which is the kind of validated, sanitized fix the AI recommended."},
  {type:"match", lo:"1.5.A", prompt:"Every AI recommendation needs a knowledgeable human to review it. Match each recommendation to its reviewer.",
    pairs:[
      ["New firewall rule or access control","Security technician"],
      ["Fix for a vulnerability in application code","Programmer"],
      ["New rule for an automated detection system","Detection engineer"]
    ], explain:"AI tools recommend; qualified people check before anything is implemented."},
  {type:"tf", lo:"1.5.A", prompt:"Because AI code review is fast and accurate, its suggested fixes can go straight to production without developer review.", options:TF, answer:1,
    explain:"Recommendations should always be reviewed by a knowledgeable programmer, and Scenario 1E also sends the app to a testing environment first."},
  {type:"mc", lo:"1.5.B", prompt:"Why do defenders need AI tools to find malicious activity on a network?",
    options:["Humans are not allowed to read logs","There are millions of events a day, far too many for people to examine carefully","AI never produces mistakes","Adversaries only attack at night"], answer:1,
    explain:"Some of those millions of events are malicious, and humans cannot inspect them all. AI can triage them quickly."},
  {type:"sort", lo:"1.5.B", prompt:"Train the sentry. Sort these overnight events the way a good AI triage model would.",
    cats:["Likely malicious","Likely harmless"],
    items:[
      {text:"500 failed logins in 2 minutes from one IP", cat:0},
      {text:"Employee logs in at 9:02 AM from the office", cat:1},
      {text:"A laptop uploads 4 GB to an unknown server at 3 AM", cat:0},
      {text:"Scheduled 1 AM backup to the company's own server", cat:1},
      {text:"New administrator account created at 2 AM from an unknown device", cat:0},
      {text:"Printer downloads an update from its manufacturer", cat:1}
    ], explain:"Volume, unusual timing, unknown sources and privilege changes are indicators of compromise. Scheduled, expected activity is not."},
  {type:"multi", lo:"1.5.B", prompt:"Once an AI tool detects likely malicious activity, what can it be programmed to do? Select all that apply.",
    options:["Alert human cybersecurity personnel","Take a specific corrective action, such as blocking the source","Guarantee there will never be a false alarm","Permanently remove the need for human detection engineers"], answer:[0,1],
    explain:"AI can alert people or take predefined corrective actions, helping teams intervene quickly. It does not replace human judgment."},
  {type:"written", lo:"1.5.A", prompt:"<b>Scenario 1E.</b> Describe <b>one advantage</b> and <b>one disadvantage</b> of using an AI-powered tool to review application code, and explain <b>why</b> the development team should review the changes before implementing them.",
    rubric:"Advantage (speed/scale) + disadvantage (errors, false positives, missed context) + reason for human review"}
  ]},
{ id:"r6", night:2, name:"The Midnight Gauntlet", topic:"Unit 1 Final Review", los:"1.1-1.5",
  brief:"The clock strikes twelve. Every ghost from the house is waiting in one hallway. This gauntlet mixes all five topics. Clear it to escape the Haunted Network.",
  qs:[
  {type:"match", lo:"Vocab", prompt:"Name the spirits. Match each acronym to its meaning.",
    pairs:[
      ["IoC","A sign of suspicious activity, often found in logs, that suggests an attack"],
      ["MFA","Requiring extra proof of identity in addition to a password"],
      ["SSID","The broadcast name of a wireless network"],
      ["WAP","The device that creates a wireless network"],
      ["OTP","A code that works for one login and then expires"],
      ["VPN","Encrypts all your traffic to the provider's system"],
      ["DoS","An attack that prevents users from accessing resources"],
      ["LLM","A generative AI model that produces human-like text"]
    ], explain:"These eight terms show up all over Unit 1."},
  {type:"mc", lo:"1.1.C", prompt:"A text says: \"Hi it's Grandma, new phone! I just sent you a code by accident, can you text it back to me?\" What happens if you send it?",
    options:["Grandma gets her new phone set up","An adversary can use the one-time code to log in to your account","Your phone gets jammed","Nothing, codes are harmless"], answer:1,
    explain:"Combining impersonation with a request for a one-time code is a common way to take over accounts."},
  {type:"mc", lo:"1.3.B", prompt:"Someone walks slowly around the school building with a laptop, recording which Wi-Fi beacons can be detected from the parking lot. This is:",
    options:["Jamming","War driving","An evil twin","Elicitation"], answer:1,
    explain:"War driving detects wireless beacons while moving around a target to learn about the network and where its signal leaks outside."},
  {type:"fill", lo:"1.3.A", prompt:"Undocumented vulnerabilities discovered by high-skilled adversaries are called ________ days.",
    accept:["^zero$","^0$","^zero[- ]?days?$"], answerText:"zero (zero days)",
    explain:"Defenders have had zero days to fix a vulnerability nobody knew about."},
  {type:"log", lo:"1.2.A / 1.5.B", prompt:"The sentry flagged this school email server excerpt. <b>Flag the rows that are indicators of compromise.</b> Teacher L. Jones works 7 AM to 4 PM.",
    cols:["Time","Account","Event","Source"],
    rows:[
      ["07:58","ljones","Login success","Room 214 desktop"],
      ["12:10","ljones","Opened link g00gle-share.com","Room 214 desktop"],
      ["12:11","ljones","Password entered on external page","Room 214 desktop"],
      ["02:41","ljones","Login success","Unknown device, overseas IP"],
      ["02:44","ljones","Mail forwarding rule created","Unknown device, overseas IP"],
      ["15:30","ljones","Logout","Room 214 desktop"]
    ], flags:[1,2,3,4],
    explain:"The phishing click and password entry led to a 2:41 AM login from an unknown device, then a forwarding rule to silently copy mail. Normal workday logins are fine."},
  {type:"written", lo:"Capstone", prompt:"<b>Escape essay.</b> Choose one attack you met tonight. In 4-6 sentences, explain the <b>vulnerability</b> it exploits, <b>how an adversary takes advantage</b> of it, <b>one sign you could detect</b> it, and <b>one way to mitigate</b> the risk.",
    rubric:"Vulnerability + exploitation + detection sign + mitigation"}
