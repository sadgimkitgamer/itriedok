    const row=h("div",{class:"pair"+(locked?(cur[i]===i?" ok":" no"):"")},h("label",{class:"term",for:q.id+"-s"+i},p[0]),sel);
    if(locked&&cur[i]!==i)row.append(h("p",{class:"fix"},"Correct: "+p[1]));box.append(row);});el.append(box);},
 sort(q,el,r,locked,set){const cur=[...r];const box=h("div",{class:"pairs"});
  q.items.forEach((it,i)=>{const grp=h("div",{class:"seggrp",role:"group","aria-label":it.text});
    q.cats.forEach((c,k)=>{const b=h("button",{class:"chip","aria-pressed":String(cur[i]===k),disabled:locked,onclick:()=>{cur[i]=k;[...grp.children].forEach((x,j)=>x.setAttribute("aria-pressed",String(j===k)));set([...cur]);}},c);grp.append(b);});
    const row=h("div",{class:"sortitem"+(locked?(cur[i]===it.cat?" ok":" no"):"")},h("span",null,it.text),grp);
    if(locked&&cur[i]!==it.cat)row.append(h("p",{class:"fix"},"Belongs in: "+q.cats[it.cat]));box.append(row);});el.append(box);},
 order(q,el,r,locked,set){let cur=[...r];const ol=h("ol",{class:"orderlist"});
  const draw=()=>{ol.innerHTML="";cur.forEach((v,pos)=>{const li=h("li",{class:locked?(v===pos?"ok":"no"):null},h("span",null,q.items[v]));
