  case"hotspot":case"log":return setFrac(r,flagsOf(q));
  case"match":return r.filter((d,i)=>d===i).length/q.pairs.length;
  case"sort":return r.filter((c,i)=>c===q.items[i].cat).length/q.items.length;
  case"order":return r.filter((v,i)=>v===i).length/q.items.length;
